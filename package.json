{
  "name": "vyline-search",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop LINE (Themida) + Android APK 解析: unpack → string scan → LEA xref → Ghidra/jadx decompile → diff",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vyline-search": "./src/cli.ts"
  },
  "scripts": {
    "unpack": "bun ./src/unpackLine.ts",
    "find": "bun ./src/findNativeSymbol.ts",
    "focus": "bun ./src/focusRecoveredSource.ts",
    "check": "bun ./src/checkVersion.ts",
    "latest": "bun ./src/cli.ts latest",
    "update": "bun ./src/updateLine.ts",
    "versions": "bun ./src/versions.ts",
    "apk": "bun ./src/cliApk.ts",
    "search": "bun ./src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
